# nest | rust  — proxy /api/graphql
GRAPHQL_UPSTREAM=nest

# GraphQL Nest (dcim-topology-service)
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
GRAPHQL_INTERNAL_URL=http://localhost:4000/graphql

# Palier A/C — sidecar Rust
RUST_GATEWAY_URL=http://127.0.0.1:8088
NEXT_PUBLIC_RUST_URL=http://127.0.0.1:8088

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=dcim
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
